    {
      "parameters": {
        "jsCode": "const clean = (html) => String(html || '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst relevan = /(\\$?\\b(btc|eth)\\b|bitcoin|ethereum)/i;\nconst spam = /(bitcoincash|\\bbch\\b)/i;\nconst kataInggris = /\\b(the|and|is|are|this|that|with|will|has|have|was|to|of|for|it|be|you|on)\\b/gi;\nconst seen = new Set();\n\nreturn $input.all()\n  .map(i => ({\n    json: {\n      id: i.json.id,\n      text: clean(i.json.content),\n      created_at: i.json.created_at,\n    }\n  }))\n  .filter(i => {\n    const t = i.json.text;\n    if (!t || !relevan.test(t) || spam.test(t)) return false;\n    // hanya teks berbahasa Inggris: minimal 3 kata umum Inggris\n    if ((t.match(kataInggris) || []).length < 3) return false;\n    // buang duplikat (abaikan nama akun @...)\n    const key = t.replace(/\\S*@\\S*/g, '').slice(0, 60).toLowerCase();\n    if (seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  });"
      },

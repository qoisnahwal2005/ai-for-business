    {
      "parameters": {
        "jsCode": "// Menghitung total dan persentase tiap sentimen\nconst rows = $input.all();\nlet positive = 0, negative = 0, neutral = 0;\n\nfor (const row of rows) {\n  const s = String(row.json.Sentiment || '').trim().toLowerCase();\n  if (s.startsWith('positive')) positive++;\n  else if (s.startsWith('negative')) negative++;\n  else if (s.startsWith('neutral')) neutral++;\n}\n\nconst total = positive + negative + neutral;\nconst pct = (n) => total ? Math.round((n / total) * 1000) / 10 : 0;\n\nconst stats = [\n  { label: 'Positif', count: positive, persen: pct(positive) },\n  { label: 'Negatif', count: negative, persen: pct(negative) },\n  { label: 'Netral',  count: neutral,  persen: pct(neutral) },\n];\nconst dominan = stats.slice().sort((a, b) => b.count - a.count)[0];\n\nreturn [{\n  json: {\n    total, positive, negative, neutral,\n    persen_positive: pct(positive),\n    persen_negative: pct(negative),\n    persen_neutral: pct(neutral),\n    sentimen_dominan: total ? dominan.label : 'Tidak ada data',\n    persen_dominan: total ? dominan.persen : 0,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

    {
      "parameters": {
        "promptType": "define",
        "text": "=Anda adalah analis keamanan siber. Analisis teks email ini untuk tanda-tanda phishing keuangan. Fokus pada urgensi palsu, tautan mencurigakan, permintaan info pribadi, atau peniruan identitas bank. Beri skor bahaya dari 1 sampai 10. Jawab HANYA dengan format: 'Skor: [angka]'.\n\nEmail: {{ $json.snippet }}\nSubject: {{ $json.Subject }}",
        "batching": {}
      },
      "id": "0cbddda2-91fa-4943-87dd-3b7852f891b1",
      "name": "Analisa Phising",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        512,
        1552
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ambil data dari node-node sebelumnya\n// $json.text adalah output dari Basic LLM Chain\nconst llmOutput = String($json.text ?? \"\");\n\n// Message ID diambil dari \"Gmail Trigger\"\n// (output LLM Chain hanya berisi teks, tanpa data email)\nconst emailMessageId = $('Gmail Trigger1').item.json.id;\n\n// Gunakan regex untuk menemukan \"Skor: [angka]\"\nconst match = llmOutput.match(/Skor:\\s*(\\d+)/);\n\nlet score = 0;\n\n// Jika ditemukan, ambil angkanya\nif (match && match[1]) {\n  score = parseInt(match[1], 10);\n}\n\n// Kembalikan skor DAN messageId untuk node IF dan Gmail\nreturn {\n  score: score,\n  messageId: emailMessageId\n};"
      },
      "id": "a6cfa576-df86-4b38-9f2b-7a50f0b74bc5",
